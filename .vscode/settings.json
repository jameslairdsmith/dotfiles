{
  "nix.formatterPath": [
    "nixfmt"
  ],
  "[nix]": {
    "editor.defaultFormatter": "ibecker.treefmt-vscode",
    "editor.formatOnSave": true
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "nixfmt"
        ],
      }
    }
  }
}
