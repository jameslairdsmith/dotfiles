# Worktrunk shell integration
if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init bash)"
  eval "$(declare -f wt | sed '1s/wt/__wt_orig/')"
  wt() {
    if [ "$1" = "remove" ]; then
      shift
      __wt_orig remove --no-delete-branch "$@"
    else
      __wt_orig "$@"
    fi
  }
fi

cdmacs() {
  local output directory picker_status

  if ! command -v cdmacs-picker >/dev/null 2>&1; then
    echo "cdmacs: cdmacs-picker is not installed" >&2
    return 1
  fi

  output="$(mktemp -t cdmacs.XXXXXX)" || return
  command cdmacs-picker "$output"
  picker_status=$?
  if [ "$picker_status" -eq 0 ] && [ -s "$output" ]; then
    IFS= read -r directory < "$output"
  fi
  command rm -f "$output"

  if [ -n "$directory" ] && [ -d "$directory" ]; then
    builtin cd -- "$directory"
  else
    return "$picker_status"
  fi
}
