{
  config,
  pkgs,
  ...
}:
let
  python = pkgs.python3;
  elispAutofmt = pkgs.writeShellScriptBin "elisp-autofmt" ''
    if [ "$#" -eq 0 ]; then
      echo "usage: elisp-autofmt FILE..." >&2
      exit 2
    fi

    emacs_args=(
      --batch
      --quick
      --eval '(setq elisp-autofmt-python-bin "${python}/bin/python3")'
      --eval '(require (quote elisp-autofmt))'
    )

    for file in "$@"; do
      emacs_args+=(
        --file "$file"
        --funcall elisp-autofmt-buffer-to-file
      )
    done

    exec ${config.programs.emacs.finalPackage}/bin/emacs \
      "''${emacs_args[@]}"
  '';
in
{
  programs.emacs = {
    enable = true;
    package = pkgs.emacs-macport;
    extraPackages =
      epkgs:
      let
        treesitGrammars = epkgs.treesit-grammars.with-grammars (grammars: [ grammars.tree-sitter-nix ]);
        grease = epkgs.trivialBuild {
          pname = "grease";
          version = "0-unstable-2026-07-21";
          src = pkgs.fetchFromGitHub {
            owner = "mwac-dev";
            repo = "grease.el";
            rev = "5e65843f257b71d195a59d1f4e66570e9b5107fc";
            hash = "sha256-yDfiXEARN61Bh9QV29HGe9llwP9GY6R2PCac1Fo7rhw=";
          };
          packageRequires = with epkgs; [
            evil
            nerd-icons
          ];
        };
      in
      with epkgs;
      [
        treesitGrammars
        nix-ts-mode
        elisp-autofmt
        dashboard
        doom-themes
        mini-echo
        vertico
        vertico-posframe
        marginalia
        orderless
        consult
        consult-dir
        ace-window
        avy
        tabgo
        tabspaces
        treemacs
        treemacs-evil
        treemacs-magit
        treemacs-nerd-icons
        treemacs-tab-bar
        popper
        evil
        evil-collection
        ess
        magit
        gptel
        gptel-magit
        markdown-mode
        olivetti
        vterm
        kkp
        eat
        agent-shell
        grease
      ];
  };

  home.packages = [
    elispAutofmt
    (pkgs.writeShellScriptBin "magit" ''
      export JLS_EMACS_PROFILE=magit

      if ! ${config.programs.emacs.finalPackage}/bin/emacsclient \
        --socket-name=magit \
        --eval t >/dev/null 2>&1; then
        ${config.programs.emacs.finalPackage}/bin/emacs --daemon=magit
      fi

      exec ${config.programs.emacs.finalPackage}/bin/emacsclient \
        --socket-name=magit \
        --tty \
        --eval '(setq jls/quick-magit-session t)' \
        --eval '(magit-status)' \
        --eval '(setq jls/quick-magit-directory default-directory)'
    '')
    (pkgs.writeShellScriptBin "dired" ''
      export JLS_EMACS_PROFILE=dired
      exec ${config.programs.emacs.finalPackage}/bin/emacsclient \
        --socket-name=dired \
        --alternate-editor="" \
        --tty \
        -- "''${1:-$PWD}"
    '')
    (pkgs.writeShellScriptBin "cdmacs-picker" ''
      if [ "$#" -ne 1 ]; then
        echo "usage: cdmacs-picker OUTPUT-FILE" >&2
        exit 2
      fi

      : > "$1"
      export JLS_EMACS_PROFILE=cdmacs
      exec ${config.programs.emacs.finalPackage}/bin/emacsclient \
        --socket-name=cdmacs \
        --alternate-editor="" \
        --tty \
        --eval "(jls/cdmacs-start \"$1\")"
    '')
    (pkgs.writeShellScriptBin "pimacs" ''
      export JLS_EMACS_PROFILE=agent-shell
      exec ${config.programs.emacs.finalPackage}/bin/emacsclient \
        --socket-name=agent-shell \
        --alternate-editor="" \
        --tty \
        --eval '(agent-shell-pi-start-agent)'
    '')
  ];

  home.file.".config/emacs/init.el".source =
    config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/projects/dotfiles/emacs/init.el";

  home.file.".config/emacs/early-init.el".source =
    config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/projects/dotfiles/emacs/early-init.el";

  home.file.".config/emacs/config-elisp".source =
    config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/projects/dotfiles/emacs/config-elisp";

  home.file.".config/emacs/nix-paths.el".text = ''
    ;;; nix-paths.el --- Nix-injected store paths -*- lexical-binding: t; -*-
    ;;; Commentary:
    ;; Generated by Home Manager (nix/modules/emacs.nix). Do not edit.
    ;;; Code:
    (setq elisp-autofmt-python-bin "${python}/bin/python3")
    (setq jls-fd-program "${pkgs.fd}/bin/fd")
    (setq jls-nixd-program "${pkgs.nixd}/bin/nixd")
    (setq jls-nixfmt-program "${pkgs.nixfmt}/bin/nixfmt")
    (setq jls-treefmt-program "${pkgs.treefmt}/bin/treefmt")
    (provide 'nix-paths)
    ;;; nix-paths.el ends here
  '';
}
